<section id="apps" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6">
  <p class="reveal font-mono2 text-xs tracking-widest text-pulse">— FLAGSHIP APP</p>
  <h2 class="reveal mt-2 text-3xl font-bold sm:text-4xl">From the studio</h2>
  <div class="reveal mx-auto mt-10 max-w-2xl overflow-hidden rounded-3xl border border-white/10 bg-surface transition hover:border-pulse/50">
    <img src="samba-s3-bg.jpg" alt="Samba S3 artwork" class="aspect-[16/7] w-full object-cover object-right" loading="lazy" />
    <div class="p-8 text-center sm:p-10">
      <img src="samba-s3-icon.png" alt="Samba S3 logo" class="-mt-16 h-24 w-24 rounded-3xl border-4 border-surface object-cover" loading="lazy" />
      <p class="mt-5 font-mono2 text-[11px] tracking-widest text-pulse">PS3 EMULATION · ANDROID</p>
      <h3 class="mt-2 text-3xl font-bold">Samba S3</h3>
