---
const faqs = [
  { q: "Where do I download ZenithBlue apps?", a: "From each app's GitHub releases page or the Play Store listing linked on the app card. Samba S3 builds ship via GitHub releases." },
  { q: "Are the apps free?", a: "Yes — the studio's apps are free. Some may offer optional builds or flavors (e.g. Turnip driver variants)." },
  { q: "How do I report a bug?", a: "Open an issue on the app's GitHub repo with your device model, SoC, Android version and a logcat if possible." },
  { q: "Can I contribute?", a: "Absolutely. Fork the repo, keep changes small and tested, and open a PR against the FOSS mirror where available." },
];
---

<section id="faq" class="mx-auto max-w-4xl scroll-mt-20 px-4 py-20 sm:px-6">
  <p class="reveal font-mono2 text-xs tracking-widest text-pulse">— FAQ</p>
  <h2 class="reveal mt-2 text-3xl font-bold sm:text-4xl">Questions, answered</h2>
  <div class="mt-8 space-y-3">
    {faqs.map((f) => (
      <div class="faq-item reveal rounded-2xl border border-white/10 bg-surface" data-open="false">
        <button class="faq-q flex w-full items-center justify-between gap-4 px-5 py-4 text-left font-bold">
          {f.q}
          <svg class="faq-chevron h-5 w-5 shrink-0 text-pulse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="faq-answer"><div class="overflow-hidden"><p class="px-5 pb-5 text-warm">{f.a}</p></div></div>
      </div>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll(".faq-q").forEach((b) =>
    b.addEventListener("click", () => {
      const item = b.closest(".faq-item");
      const open = item?.getAttribute("data-open") === "true";
      item?.setAttribute("data-open", open ? "false" : "true");
    })
  );
</script>
