---

<section id="top" class="relative overflow-hidden">
  <div class="glow-grid absolute inset-0" aria-hidden="true"></div>
  <div class="absolute -top-32 left-1/2 h-96 w-[42rem] -translate-x-1/2 rounded-full bg-pulse/15 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 pb-20 pt-16 sm:px-6 md:grid-cols-2 md:pt-24">
    <div class="reveal">
      <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-pulse/30 bg-pulse/10 px-4 py-1.5 font-mono2 text-xs tracking-widest text-pulse">ANDROID APPS · DONE RIGHT</p>
      <h1 class="text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">
        Apps that feel<br />fast, <span class="text-pulse">focused</span>,<br />and native.
      </h1>
      <p class="mt-5 max-w-md text-lg text-warm">
        ZenithBlue builds sharp Android tools — home of Samba S3, console-grade emulation. No bloat. No clutter.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#apps" class="rounded-2xl bg-pulse px-6 py-3 font-bold text-abyss transition hover:bg-focus">Explore apps</a>
        <a href="https://github.com/zenithblue-dev" class="rounded-2xl border border-white/20 px-6 py-3 font-bold text-cream transition hover:border-pulse hover:text-pulse">GitHub org</a>
      </div>
      <div class="mt-8 flex gap-8">
        <div><p class="text-2xl font-bold text-pulse">1</p><p class="text-sm text-warm">Flagship app</p></div>
        <div><p class="text-2xl font-bold text-pulse">100%</p><p class="text-sm text-warm">Native-first</p></div>
        <div><p class="text-2xl font-bold text-pulse">0</p><p class="text-sm text-warm">Bloat added</p></div>
      </div>
    </div>

    <div class="reveal flex justify-center">
      <div class="relative">
        <div class="absolute inset-0 -z-10 scale-110 rounded-[3rem] bg-pulse/20 blur-3xl" aria-hidden="true"></div>
        <img src="logo.png" alt="ZenithBlue" class="float-slow w-64 rounded-[2.5rem] border border-pulse/30 object-cover shadow-2xl sm:w-80" />
      </div>
    </div>
  </div>

  <div class="relative border-y border-white/10 bg-surface/60 py-3">
    <div class="overflow-hidden">
      <div class="ticker-inner flex w-max gap-10 whitespace-nowrap px-4 font-mono2 text-xs tracking-widest text-warm">
        <span>NATIVE ANDROID</span><span class="text-pulse">◆</span><span>SAMBA S3</span><span class="text-pulse">◆</span><span>PS3 EMULATION</span><span class="text-pulse">◆</span><span>OPEN SOURCE</span><span class="text-pulse">◆</span><span>NO BLOAT</span><span class="text-pulse">◆</span>
        <span>NATIVE ANDROID</span><span class="text-pulse">◆</span><span>SAMBA S3</span><span class="text-pulse">◆</span><span>PS3 EMULATION</span><span class="text-pulse">◆</span><span>OPEN SOURCE</span><span class="text-pulse">◆</span><span>NO BLOAT</span><span class="text-pulse">◆</span>
      </div>
    </div>
  </div>
</section>
