---
const links = [
  { href: "#apps", label: "Apps" },
  { href: "#why", label: "Why us" },
  { href: "#download", label: "Get apps" },
  { href: "#faq", label: "FAQ" },
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-abyss/85 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="#top" class="flex items-center gap-3">
      <img src="logo.png" alt="ZenithBlue logo" class="h-9 w-9 rounded-xl object-cover" />
      <span class="text-lg font-bold tracking-wide">ZENITH<span class="text-pulse">BLUE</span></span>
    </a>
    <div class="hidden items-center gap-7 md:flex">
      {links.map((l) => (
        <a href={l.href} class="text-sm font-semibold tracking-wide text-warm transition hover:text-cream">{l.label}</a>
      ))}
      <a href="https://github.com/zenithblue-dev" class="rounded-xl bg-pulse px-4 py-2 text-sm font-bold text-abyss transition hover:bg-focus">GitHub</a>
    </div>
    <button id="menu-btn" class="rounded-lg border border-white/15 p-2 md:hidden" aria-label="Menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </nav>
  <div id="mobile-menu" class="hidden border-t border-white/10 px-4 py-3 md:hidden">
    {links.map((l) => (
      <a href={l.href} class="block rounded-lg px-2 py-2 font-semibold text-warm hover:bg-white/5 hover:text-cream">{l.label}</a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => menu?.classList.add("hidden")));
</script>
